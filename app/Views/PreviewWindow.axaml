<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SaberBridge.ViewModels"
        xmlns:app="using:SaberBridge"
        xmlns:c="using:SaberBridge.Controls"
        x:Class="SaberBridge.Views.PreviewWindow"
        x:DataType="vm:PreviewViewModel"
        Title="{Binding Title}"
        Icon="/Assets/icon.ico"
        Width="980" Height="720" MinWidth="760" MinHeight="560"
        Background="{StaticResource Bg}"
        WindowStartupLocation="CenterOwner">

  <Grid ColumnDefinitions="*,340" Margin="20">

    <!-- stage -->
    <Grid RowDefinitions="Auto,*,Auto" Margin="0,0,20,0">
      <StackPanel Spacing="2">
        <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
        <TextBlock Classes="muted" Text="{Binding Subtitle}" />
      </StackPanel>

      <Border Grid.Row="1" Classes="card" Margin="0,14" Background="#17181F" ClipToBounds="True">
        <Panel>
          <Border x:Name="Stage" Background="Transparent" IsVisible="{Binding HasData}" Cursor="SizeWestEast">
            <Viewbox Stretch="Uniform" Margin="8">
              <Panel Width="{Binding FrameWidth}" Height="{Binding FrameHeight}">
                <Image Source="{Binding Frame}" Opacity="{Binding ModelOpacity}" />
                <c:SkeletonOverlay Segments="{Binding Segments}" />
              </Panel>
            </Viewbox>
          </Border>
          <Border IsVisible="{Binding IsTurntable}" Background="#99000000" CornerRadius="12" Padding="12,5" Margin="12"
                  HorizontalAlignment="Center" VerticalAlignment="Bottom" IsHitTestVisible="False">
            <TextBlock Text="{x:Static app:L.DragToRotate}" FontSize="12" Foreground="#CCFFFFFF" />
          </Border>

          <StackPanel IsVisible="{Binding !HasData}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="14" MaxWidth="380">
            <TextBlock Text="{x:Static app:L.PreviewMissing}" TextWrapping="Wrap" TextAlignment="Center" Classes="muted" FontSize="13" />
            <Button Classes="primary" HorizontalAlignment="Center" Content="{x:Static app:L.MakePreview}" Command="{Binding MakePreviewCommand}"
                    IsVisible="{Binding !IsRendering}" />
            <StackPanel IsVisible="{Binding IsRendering}" Spacing="8">
              <TextBlock Text="{Binding Main.Status}" HorizontalAlignment="Center" />
              <TextBlock Classes="muted" Text="{Binding Main.SubStatus}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
              <ProgressBar IsIndeterminate="{Binding Main.ProgressIndeterminate}" Value="{Binding Main.Progress}" Width="260"
                           Foreground="{StaticResource Saber}" Height="5" MinHeight="5" />
            </StackPanel>
          </StackPanel>
        </Panel>
      </Border>

      <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding HasData}">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Button Classes="ghost" Content="{Binding PlayLabel}" Command="{Binding TogglePlayCommand}" MinWidth="40" />
          <ListBox ItemsSource="{Binding AnimOptions}" SelectedItem="{Binding Anim}" Background="Transparent">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="Padding" Value="14,6" />
                <Setter Property="CornerRadius" Value="8" />
              </Style>
              <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                <Setter Property="Background" Value="{StaticResource Blue}" />
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:AnimOption">
                <TextBlock Text="{Binding Label}" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <CheckBox Content="{x:Static app:L.Skeleton}" IsChecked="{Binding ShowSkeleton}" />
          <CheckBox Content="{x:Static app:L.SkeletonOnly}" IsChecked="{Binding SkeletonOnly}" />
        </StackPanel>
      </Grid>
    </Grid>

    <!-- side: checks and actions -->
    <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto">
      <Border Classes="card" Padding="16" Margin="0,0,0,12">
        <StackPanel Spacing="8">
          <Image Source="{Binding Card.Cover}" Height="120" Stretch="Uniform" HorizontalAlignment="Left" IsVisible="{Binding !Card.HasNoCover}" />
          <StackPanel Orientation="Horizontal" Spacing="14">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Border Width="16" Height="3" CornerRadius="2" Background="{StaticResource Blue}" VerticalAlignment="Center" />
              <TextBlock Classes="muted" Text="{x:Static app:L.LegendBones}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Border Width="16" Height="3" CornerRadius="2" Background="{StaticResource Warn}" VerticalAlignment="Center" />
              <TextBlock Classes="muted" Text="{x:Static app:L.LegendPhysics}" TextWrapping="Wrap" MaxWidth="160" />
            </StackPanel>
          </StackPanel>
          <TextBlock Classes="muted" Text="{x:Static app:L.PhysicsNote}" TextWrapping="Wrap" FontSize="11" Opacity="0.8" />
        </StackPanel>
      </Border>

      <Border Grid.Row="1" Classes="card" Padding="16">
        <Grid RowDefinitions="Auto,*">
          <TextBlock Classes="h2" Text="{x:Static app:L.Checks}" Margin="0,0,0,10" />
          <ScrollViewer Grid.Row="1">
            <ItemsControl ItemsSource="{Binding Checks}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:CheckRow">
                  <Grid ColumnDefinitions="22,*" Margin="0,4">
                    <TextBlock Text="{Binding Icon}" Foreground="{Binding Brush}" FontWeight="Bold" />
                    <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" FontSize="13" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>

      <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0" HorizontalAlignment="Right">
        <Button Classes="ghost danger" Content="{x:Static app:L.Delete}" Click="Delete_Click" />
        <Button Classes="primary" Padding="20,9" Content="{Binding Card.InstallLabel}" IsVisible="{Binding Card.CanInstall}"
                Command="{Binding Main.InstallCardCommand}" CommandParameter="{Binding Card}" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
