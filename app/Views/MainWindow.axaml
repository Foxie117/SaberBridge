<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SaberBridge.ViewModels"
        xmlns:core="using:SaberBridge.Core"
        xmlns:app="using:SaberBridge"
        x:Class="SaberBridge.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="SaberBridge"
        Icon="/Assets/icon.ico"
        Width="1240" Height="800" MinWidth="960" MinHeight="620"
        Background="{StaticResource Bg}"
        WindowStartupLocation="CenterScreen">

  <Grid RowDefinitions="Auto,3,*,Auto">

    <!-- header -->
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" Margin="24,18,24,14">
      <StackPanel Orientation="Horizontal" Spacing="14">
        <Image Source="/Assets/logo.png" Width="44" Height="44" />
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="SaberBridge" FontSize="22" FontWeight="Bold" />
          <TextBlock Classes="muted" Text="{x:Static app:L.Subtitle}" />
        </StackPanel>
      </StackPanel>

      <!-- tabs -->
      <Border Grid.Row="1" Grid.ColumnSpan="3" Margin="0,16,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{StaticResource Panel}"
              BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="22" Padding="4">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <Button Classes="tab" Classes.active="{Binding IsAvatarsTab}" Content="{Binding PcTabTitle}" Command="{Binding SelectTabCommand}" CommandParameter="0" />
          <Button Classes="tab" Classes.active="{Binding IsQuestTab}" Content="{Binding QuestTabTitle}" Command="{Binding SelectTabCommand}" CommandParameter="1" />
        </StackPanel>
      </Border>

      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <Button Classes="chip" Command="{Binding ToggleSystemCheckCommand}" ToolTip.Tip="{x:Static app:L.SystemCheck}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Ellipse Width="8" Height="8" Fill="{StaticResource Ok}" IsVisible="{Binding SystemCheck.AllGood}" />
            <Ellipse Width="8" Height="8" Fill="{StaticResource Warn}" IsVisible="{Binding !SystemCheck.AllGood}" />
            <TextBlock Text="{Binding SystemCheck.Summary}" FontSize="12" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Border Classes="card" Padding="12,6" CornerRadius="20">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Ellipse Width="8" Height="8" Fill="{StaticResource Ok}" IsVisible="{Binding UnityReady}" />
            <Ellipse Width="8" Height="8" Fill="{StaticResource Red}" IsVisible="{Binding !UnityReady}" />
            <TextBlock Text="{Binding UnityText}" FontSize="12" VerticalAlignment="Center" />
          </StackPanel>
        </Border>
        <Border Classes="card" Padding="12,2,4,2" CornerRadius="20" IsVisible="{Binding IsAvatarsTab}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Ellipse Width="8" Height="8" Fill="{StaticResource Ok}" IsVisible="{Binding GameOk}" />
            <Ellipse Width="8" Height="8" Fill="{StaticResource Red}" IsVisible="{Binding !GameOk}" />
            <ComboBox ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame}" MinWidth="170"
                      Background="Transparent" BorderThickness="0" FontSize="12"
                      PlaceholderText="{x:Static app:L.GameMissing}" IsEnabled="{Binding !IsBusy}" />
          </StackPanel>
        </Border>
        <Button Classes="chip" Command="{Binding ToggleLanguageCommand}" ToolTip.Tip="{x:Static app:L.Language}" MinWidth="44">
          <TextBlock Text="{Binding LanguageCode}" FontSize="12" FontWeight="SemiBold" />
        </Button>
        <Button Classes="ghost" Command="{Binding ToggleSettingsCommand}" ToolTip.Tip="{x:Static app:L.Settings}" Padding="10,7">
          <PathIcon Width="16" Height="16" Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z" />
        </Button>
      </StackPanel>
    </Grid>

    <Border Grid.Row="1" Background="{StaticResource Saber}" Opacity="0.85" />

    <!-- body -->
    <Grid Grid.Row="2" ColumnDefinitions="400,*" Margin="24,20,24,12" IsVisible="{Binding IsAvatarsTab}">

      <!-- left: drop zone + queue -->
      <Grid RowDefinitions="Auto,Auto,*" Margin="0,0,20,0">
        <Panel x:Name="DropZone" Height="180" DragDrop.AllowDrop="True" Background="Transparent">
          <Border x:Name="DropGlow" Classes="card" Background="{StaticResource Panel}" />
          <Rectangle x:Name="DropDash" Margin="10" RadiusX="10" RadiusY="10" Stroke="#3A3F58" StrokeThickness="2" StrokeDashArray="5,4" />
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10">
            <PathIcon Width="36" Height="36" Foreground="{StaticResource Blue}"
                      Data="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M13.5,16V19H10.5V16H8L12,12L16,16H13.5M13,9V3.5L18.5,9H13Z" />
            <TextBlock Text="{x:Static app:L.DropTitle}" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock Classes="muted" Text="{x:Static app:L.DropHint}" HorizontalAlignment="Center" />
            <Button Classes="ghost" Content="{x:Static app:L.Browse}" HorizontalAlignment="Center" Click="Browse_Click" IsEnabled="{Binding !IsBusy}" />
          </StackPanel>
        </Panel>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="4,18,0,8">
          <TextBlock Classes="h2" Text="{x:Static app:L.Queue}" VerticalAlignment="Center" />
          <Button Grid.Column="1" Classes="ghost" FontSize="12" Padding="10,4" Content="{x:Static app:L.Clear}"
                  Command="{Binding ClearQueueCommand}" IsVisible="{Binding !QueueEmpty}" IsEnabled="{Binding !IsBusy}" />
        </Grid>

        <ScrollViewer Grid.Row="2">
          <ItemsControl ItemsSource="{Binding Queue}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Spacing="6" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:QueueItem">
                <Border Classes="card" Padding="12,10" CornerRadius="10" ToolTip.Tip="{Binding Detail}">
                  <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                    <Border Background="{Binding BadgeBrush}" CornerRadius="6" Width="42" Height="24" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Badge}" FontSize="11" FontWeight="Bold" Foreground="White"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Classes="muted" Text="{Binding Origin}" TextTrimming="CharacterEllipsis" FontSize="11"
                                 IsVisible="{Binding Origin, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontSize="12"
                               VerticalAlignment="Center" IsVisible="{Binding !IsWorking}" />
                    <StackPanel Grid.Column="2" Width="130" Spacing="4" VerticalAlignment="Center" IsVisible="{Binding IsWorking}">
                      <TextBlock Text="{Binding StageText}" Foreground="{StaticResource Blue}" FontSize="11" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" />
                      <ProgressBar Value="{Binding Percent}" Height="3" MinHeight="3" MinWidth="0" Foreground="{StaticResource Blue}" />
                    </StackPanel>
                    <Button Grid.Column="3" Margin="6,0,0,0" Padding="6" Background="Transparent"
                            Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).RemoveCommand}"
                            CommandParameter="{Binding}">
                      <PathIcon Width="10" Height="10" Foreground="{StaticResource Muted}"
                                Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z" />
                    </Button>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>

      <!-- right: library -->
      <Border Grid.Column="1" Classes="card" Padding="20">
        <Grid RowDefinitions="Auto,*">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <TextBlock Classes="h2" Text="{Binding LibraryHeader}" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding SearchText}" Watermark="{x:Static app:L.Search}" Margin="16,0" MaxWidth="260"
                     HorizontalAlignment="Left" FontSize="12" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
              <Button Classes="ghost" Content="{Binding PreviewAllLabel}" Command="{Binding PreviewAllCommand}" IsVisible="{Binding HasMissingPreviews}" />
              <Button Classes="ghost" Content="{x:Static app:L.OpenGameFolder}" Command="{Binding OpenGameAvatarsCommand}" />
              <Button Classes="ghost" Content="{x:Static app:L.InstallAll}" Command="{Binding InstallAllNewCommand}"
                      IsEnabled="{Binding GameOk}" IsVisible="{Binding HasNewToInstall}" />
            </StackPanel>
          </Grid>

          <TextBlock Grid.Row="1" Classes="muted" Text="{x:Static app:L.LibraryEmpty}" TextAlignment="Center" FontSize="13"
                     HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding LibraryEmpty}" />

          <ScrollViewer Grid.Row="1" Margin="0,16,0,0" IsVisible="{Binding !LibraryEmpty}" x:Name="LibraryScroll">
            <ItemsControl ItemsSource="{Binding VisibleAvatars}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:AvatarCard">
                  <Border Classes="avatar" Classes.new="{Binding IsNew}" Width="160" Margin="0,0,12,12" CornerRadius="12"
                          Background="{StaticResource PanelHi}" ClipToBounds="True">
                    <StackPanel>
                      <Button Classes="cover" Padding="0" Background="#12131B" Height="160" HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" ToolTip.Tip="{x:Static app:L.Preview}"
                              Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).OpenPreviewCommand}" CommandParameter="{Binding}">
                        <Panel>
                          <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                          <TextBlock Text="?" FontSize="44" Foreground="#3A3F58" HorizontalAlignment="Center" VerticalAlignment="Center"
                                     IsVisible="{Binding HasNoCover}" />
                          <Border Background="{StaticResource Saber}" CornerRadius="10" Padding="8,2" Margin="8"
                                  HorizontalAlignment="Left" VerticalAlignment="Top" IsVisible="{Binding IsNew}">
                            <TextBlock Text="{x:Static app:L.New}" FontSize="10" FontWeight="Bold" Foreground="White" />
                          </Border>
                          <Ellipse Width="10" Height="10" Margin="10" Fill="{Binding CheckBrush}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                   IsVisible="{Binding HasCheck}" />
                        </Panel>
                      </Button>
                      <StackPanel Margin="10,8,10,10" Spacing="4">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                        <TextBlock Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis">
                          <Run Text="{Binding Size}" /><Run Text="  ·  " /><Run Text="{Binding StateText}" />
                        </TextBlock>
                        <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                          <Button Classes="ghost small" Content="{Binding InstallLabel}" IsVisible="{Binding CanInstall}"
                                  Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).InstallCardCommand}" CommandParameter="{Binding}" />
                          <Button Grid.Column="1" Classes="icon" ToolTip.Tip="{x:Static app:L.Delete}"
                                  Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).DeleteCardCommand}" CommandParameter="{Binding}">
                            <PathIcon Width="13" Height="13" Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z" />
                          </Button>
                        </Grid>
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>

    <!-- Quest tab: one queue of sabers and notes -->
    <Grid Grid.Row="2" Grid.RowSpan="2" RowDefinitions="Auto,Auto,*,Auto" Margin="24,16,24,16" IsVisible="{Binding IsQuestTab}">
      <Grid Grid.Row="1" ColumnDefinitions="400,*">
        <Panel Height="150" Background="Transparent" Margin="0,0,20,0">
          <Border Classes="card" />
          <Rectangle Margin="10" RadiusX="10" RadiusY="10" Stroke="#3A3F58" StrokeThickness="2" StrokeDashArray="5,4" />
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
            <TextBlock Text="{Binding Sabers.DropTitle}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock Classes="muted" Text="{Binding Sabers.DropHint}" HorizontalAlignment="Center" />
            <Button Classes="ghost" Content="{x:Static app:L.Browse}" HorizontalAlignment="Center" Click="BrowseSabers_Click" />
          </StackPanel>
        </Panel>
        <Border Grid.Column="1" Classes="card" Padding="18,14">
          <StackPanel Spacing="8">
            <TextBlock Classes="h2" Text="{x:Static app:L.QuestFolder}" />
            <TextBlock Classes="muted" Text="{x:Static app:L.QuestFolderHint}" TextWrapping="Wrap" />
            <Grid ColumnDefinitions="*,Auto,Auto">
              <TextBox Text="{Binding Sabers.OutputDir, Mode=OneWay}" IsReadOnly="True" FontSize="12" />
              <Button Grid.Column="1" Classes="ghost" Margin="8,0,0,0" Content="{x:Static app:L.Change}" Click="PickQuestFolder_Click" />
              <Button Grid.Column="2" Classes="ghost" Margin="8,0,0,0" Content="{x:Static app:L.OpenFolder}" Command="{Binding Sabers.OpenOutputCommand}" />
            </Grid>
          </StackPanel>
        </Border>
      </Grid>

      <Border Grid.Row="2" Classes="card" Padding="20" Margin="0,20,0,0">
        <Grid RowDefinitions="Auto,*">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <TextBlock Classes="h2" Text="{Binding Sabers.Header}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Classes="muted" Text="{Binding Sabers.Summary}" Margin="16,0" VerticalAlignment="Center" />
            <Button Grid.Column="2" Classes="ghost" Content="{x:Static app:L.Refresh}" Command="{Binding Sabers.RefreshAllCommand}" />
          </Grid>
          <TextBlock Grid.Row="1" Classes="muted" Text="{Binding Sabers.EmptyText}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="520"
                     HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding Sabers.IsEmpty}" />
          <ScrollViewer Grid.Row="1" Margin="0,14,0,0" IsVisible="{Binding !Sabers.IsEmpty}">
            <ItemsControl ItemsSource="{Binding Sabers.Cards}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Spacing="6" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SaberCard">
                  <Border Background="{StaticResource PanelHi}" CornerRadius="10" Padding="14,10">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                      <Panel Width="54" Height="54" VerticalAlignment="Center">
                        <Border Background="{Binding BadgeBrush}" CornerRadius="6" Width="54" Height="24" VerticalAlignment="Center" IsVisible="{Binding !HasCover}">
                          <TextBlock Text="{Binding Badge}" FontSize="10" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border CornerRadius="8" ClipToBounds="True" IsVisible="{Binding HasCover}">
                          <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                        </Border>
                      </Panel>
                      <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <Border Background="{Binding BadgeBrush}" CornerRadius="4" Padding="5,1" VerticalAlignment="Center" IsVisible="{Binding HasCover}">
                            <TextBlock Text="{Binding Badge}" FontSize="9" FontWeight="Bold" Foreground="White" />
                          </Border>
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Classes="muted" Text="{Binding Detail}" FontSize="11" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <TextBlock Grid.Column="2" Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0" />
                      <Button Grid.Column="3" Classes="ghost small" Content="{x:Static app:L.ShowOriginal}" IsVisible="{Binding !SourceMissing}"
                              Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).Sabers.ShowOriginalCommand}" CommandParameter="{Binding}" />
                      <Button Grid.Column="4" Classes="icon" Margin="6,0,0,0" ToolTip.Tip="{x:Static app:L.Forget}"
                              Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).Sabers.RemoveCommand}" CommandParameter="{Binding}">
                        <PathIcon Width="10" Height="10" Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z" />
                      </Button>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>

      <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0,14,0,0">
        <TextBlock Classes="muted" Text="{Binding Sabers.Status}" TextWrapping="Wrap" VerticalAlignment="Center" />
        <Button Grid.Column="1" Classes="primary" Margin="20,0,0,0" Content="{x:Static app:L.Convert}" Command="{Binding Sabers.ConvertCommand}" />
      </Grid>
    </Grid>

    <!-- footer -->
    <Border Grid.Row="3" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" IsVisible="{Binding IsAvatarsTab}">
      <StackPanel>
        <Border IsVisible="{Binding ShowLog}" Height="190" Margin="24,14,24,0" Classes="card" Background="#0B0C11">
          <TextBox Text="{Binding LogText}" IsReadOnly="True" TextWrapping="Wrap" Background="Transparent" BorderThickness="0"
                   FontFamily="Cascadia Mono,Consolas,DejaVu Sans Mono,monospace" FontSize="12" x:Name="LogBox" />
        </Border>
        <Grid ColumnDefinitions="*,Auto" Margin="24,14">
          <Grid VerticalAlignment="Center" RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding Status}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="1" Text="{Binding PercentText}" FontSize="20" FontWeight="Bold" Margin="16,0,0,0"
                       Foreground="{StaticResource Saber}" VerticalAlignment="Center" Grid.RowSpan="2" />
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10" Margin="0,2,0,0">
              <TextBlock Classes="muted" Text="{Binding SubStatus}" TextTrimming="CharacterEllipsis" />
              <TextBlock Classes="muted" Text="{Binding Elapsed}" IsVisible="{Binding IsBusy}" Opacity="0.7" />
            </StackPanel>
            <ProgressBar Grid.Row="2" Grid.ColumnSpan="2" Margin="0,8,0,0" Value="{Binding Progress}" IsIndeterminate="{Binding ProgressIndeterminate}"
                         IsVisible="{Binding IsBusy}" Foreground="{StaticResource Saber}" Height="6" MinHeight="6" CornerRadius="3" />
          </Grid>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" Margin="20,0,0,0">
            <ToggleButton Classes="ghost" Content="{x:Static app:L.Log}" IsChecked="{Binding ShowLog}" Background="Transparent"
                          BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" />
            <Button Classes="ghost" Content="{x:Static app:L.Cancel}" Command="{Binding CancelCommand}" IsVisible="{Binding IsBusy}" />
            <Button Classes="primary" Content="{x:Static app:L.Convert}" Command="{Binding ConvertCommand}" />
          </StackPanel>
        </Grid>
      </StackPanel>
    </Border>

    <!-- system check overlay -->
    <Panel Grid.RowSpan="4" IsVisible="{Binding ShowSystemCheck}" Background="#B0000000">
      <Border Classes="card" Width="720" MaxHeight="700" Padding="26" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid RowDefinitions="Auto,*,Auto">
          <StackPanel Spacing="6">
            <TextBlock Text="{x:Static app:L.SystemCheck}" FontSize="20" FontWeight="Bold" />
            <TextBlock Classes="muted" Text="{Binding SystemIntro}" TextWrapping="Wrap" FontSize="13" />
          </StackPanel>

          <ScrollViewer Grid.Row="1" Margin="0,16,0,0">
            <StackPanel Spacing="8">
              <ItemsControl ItemsSource="{Binding SystemCheck.Items}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:CheckItem">
                    <Border Background="{StaticResource PanelHi}" CornerRadius="10" Padding="14,12">
                      <Grid ColumnDefinitions="30,*">
                        <Border Width="22" Height="22" CornerRadius="11" Background="{Binding LevelBrush}" VerticalAlignment="Top">
                          <TextBlock Text="{Binding Icon}" FontSize="12" FontWeight="Bold" Foreground="#0F1016"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="6">
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                          <TextBlock Classes="muted" Text="{Binding Detail}" TextWrapping="Wrap" FontSize="12" />
                          <ItemsControl ItemsSource="{Binding Actions}" IsVisible="{Binding HasActions}" IsEnabled="{Binding !IsWorking}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:CheckAction">
                                <Button Classes="ghost" Classes.accent="{Binding Primary}" Margin="0,2,8,0" FontSize="12" Padding="12,5"
                                        Content="{Binding Label}"
                                        Command="{Binding $parent[ItemsControl].((vm:CheckItem)DataContext).ActCommand}" CommandParameter="{Binding}" />
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <StackPanel Spacing="4" IsVisible="{Binding ProgressText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock Text="{Binding ProgressText}" FontSize="12" Foreground="{StaticResource Blue}" TextWrapping="Wrap" />
                            <ProgressBar Value="{Binding Progress}" IsIndeterminate="{Binding !ProgressKnown}" IsVisible="{Binding IsWorking}"
                                         Height="4" MinHeight="4" Foreground="{StaticResource Saber}" />
                          </StackPanel>
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Expander Header="{x:Static app:L.WhichUnity}" Margin="0,8,0,0" HorizontalAlignment="Stretch" IsVisible="{Binding IsAvatarsTab}">
                <StackPanel>
                  <Grid ColumnDefinitions="140,110,120,110,*" Margin="0,0,0,6">
                    <TextBlock Text="{x:Static app:L.ColGame}" FontSize="11" Classes="muted" />
                    <TextBlock Grid.Column="1" Text="{x:Static app:L.ColGameUnity}" FontSize="11" Classes="muted" />
                    <TextBlock Grid.Column="2" Text="{x:Static app:L.ColCa}" FontSize="11" Classes="muted" />
                    <TextBlock Grid.Column="3" Text="{x:Static app:L.ColEditor}" FontSize="11" Classes="muted" />
                  </Grid>
                  <ItemsControl ItemsSource="{Binding SystemCheck.Table}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="core:Compatibility+Row">
                        <Grid ColumnDefinitions="140,110,120,110,*" Margin="0,3">
                          <TextBlock Text="{Binding Game}" FontSize="12" />
                          <TextBlock Grid.Column="1" Text="{Binding GameUnity}" FontSize="12" Classes="muted" />
                          <TextBlock Grid.Column="2" Text="{Binding CustomAvatars}" FontSize="12" Classes="muted" />
                          <TextBlock Grid.Column="3" Text="{Binding EditorUnity}" FontSize="12" FontWeight="SemiBold" />
                          <TextBlock Grid.Column="4" FontSize="12" Text="{x:Static app:L.Supported}" Foreground="{StaticResource Ok}" IsVisible="{Binding Supported}" />
                          <TextBlock Grid.Column="4" FontSize="12" Text="{x:Static app:L.NotSupported}" Foreground="{StaticResource Red}" IsVisible="{Binding !Supported}" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Expander>
            </StackPanel>
          </ScrollViewer>

          <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" Margin="0,18,0,0">
            <Button Grid.Column="1" Classes="ghost" Margin="0,0,10,0" Content="{x:Static app:L.Recheck}" Command="{Binding SystemCheck.RecheckCommand}" />
            <Button Grid.Column="2" Classes="primary" Padding="22,9" Content="{x:Static app:L.Close}" Command="{Binding ToggleSystemCheckCommand}" />
          </Grid>
        </Grid>
      </Border>
    </Panel>

    <!-- settings overlay -->
    <Panel Grid.RowSpan="4" IsVisible="{Binding ShowSettings}" Background="#B0000000">
      <Border Classes="card" Width="580" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="18">
          <TextBlock Text="{x:Static app:L.Settings}" FontSize="20" FontWeight="Bold" />

          <StackPanel Spacing="6">
            <TextBlock Classes="h2" Text="Unity" />
            <TextBlock Classes="muted" Text="{x:Static app:L.UnityHint}" TextWrapping="Wrap" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBox Text="{Binding UnityPath}" IsReadOnly="True" FontSize="12" />
              <Button Grid.Column="1" Classes="ghost" Margin="8,0,0,0" Content="{x:Static app:L.Change}" Click="PickUnity_Click" />
            </Grid>
          </StackPanel>

          <StackPanel Spacing="6">
            <TextBlock Classes="h2" Text="{x:Static app:L.Game}" />
            <TextBlock Classes="muted" Text="{x:Static app:L.GameHint}" TextWrapping="Wrap" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBox Text="{Binding SelectedGame.Path, FallbackValue=''}" IsReadOnly="True" FontSize="12" />
              <Button Grid.Column="1" Classes="ghost" Margin="8,0,0,0" Content="{x:Static app:L.Change}" Click="PickGame_Click" />
            </Grid>
          </StackPanel>

          <CheckBox Content="{x:Static app:L.AutoInstall}" IsChecked="{Binding AutoInstall}" />

          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Classes="h2" Text="{x:Static app:L.Language}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <Button Classes="ghost" Content="Русский" Command="{Binding SetLanguageCommand}" CommandParameter="ru" />
            <Button Classes="ghost" Content="English" Command="{Binding SetLanguageCommand}" CommandParameter="en" />
          </StackPanel>

          <Grid ColumnDefinitions="*,Auto">
            <Button Classes="ghost" Content="{x:Static app:L.DataFolder}" Command="{Binding OpenDataFolderCommand}" />
            <Button Grid.Column="1" Classes="primary" Padding="22,9" Content="{x:Static app:L.Close}" Command="{Binding ToggleSettingsCommand}" />
          </Grid>
        </StackPanel>
      </Border>
    </Panel>

  </Grid>
</Window>
