<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SaberBridge</AssemblyName>
    <RootNamespace>SaberBridge</RootNamespace>
    <Version>0.7.1</Version>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.3" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <!-- The Unity project (converter scripts, shader, templates, UniVRM) ships inside the app as unity.zip. -->
  <Target Name="PackUnityProject" BeforeTargets="BeforeBuild">
    <PropertyGroup>
      <UnityStage>$(IntermediateOutputPath)unity\</UnityStage>
      <UnityZip>$(IntermediateOutputPath)unity.zip</UnityZip>
    </PropertyGroup>
    <ItemGroup>
      <UnityFiles Include="..\unity\**\*" Exclude="..\unity\Library\**;..\unity\Temp\**;..\unity\Logs\**;..\unity\UserSettings\**;..\unity\obj\**;..\unity\Assets\VRM2BS_Work\**;..\unity\Assets\VRC_Import\**" />
    </ItemGroup>
    <RemoveDir Directories="$(UnityStage)" />
    <Copy SourceFiles="@(UnityFiles)" DestinationFiles="@(UnityFiles->'$(UnityStage)%(RecursiveDir)%(Filename)%(Extension)')" />
    <ZipDirectory SourceDirectory="$(UnityStage)" DestinationFile="$(UnityZip)" Overwrite="true" />
    <ItemGroup>
      <EmbeddedResource Include="$(UnityZip)" LogicalName="unity.zip" />
    </ItemGroup>
  </Target>

  <!-- The Quest saber project (Unity 2019.3) ships the same way as unity-quest.zip. -->
  <Target Name="PackQuestProject" BeforeTargets="BeforeBuild">
    <PropertyGroup>
      <QuestStage>$(IntermediateOutputPath)unity-quest\</QuestStage>
      <QuestZip>$(IntermediateOutputPath)unity-quest.zip</QuestZip>
    </PropertyGroup>
    <ItemGroup>
      <QuestFiles Include="..\unity-quest\**\*" Exclude="..\unity-quest\Library\**;..\unity-quest\Temp\**;..\unity-quest\Logs\**;..\unity-quest\UserSettings\**;..\unity-quest\obj\**;..\unity-quest\Assets\SaberBridge_Work\**" />
    </ItemGroup>
    <RemoveDir Directories="$(QuestStage)" />
    <Copy SourceFiles="@(QuestFiles)" DestinationFiles="@(QuestFiles->'$(QuestStage)%(RecursiveDir)%(Filename)%(Extension)')" />
    <ZipDirectory SourceDirectory="$(QuestStage)" DestinationFile="$(QuestZip)" Overwrite="true" />
    <ItemGroup>
      <EmbeddedResource Include="$(QuestZip)" LogicalName="unity-quest.zip" />
    </ItemGroup>
  </Target>
</Project>
